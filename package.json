{
  "name": "tran-hoang-phuc-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Recruiter-facing bilingual portfolio for Trần Hoàng Phúc.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
